{
  "expo": {
    "name": "DreamManager",
    "slug": "DreamManager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hitstore770.dreammanager",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "האפליקציה משתמשת במצלמה כדי לסרוק מסמכים וברקודים."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "האפליקציה ניגשת לגלריה כדי לצרף תמונות השראה וקבלות.",
          "cameraPermission": "האפליקציה משתמשת במצלמה כדי לסרוק מסמכים."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "האפליקציה משתמשת במיקרופון כדי להקליט הערות קוליות."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "האפליקציה משתמשת במיקום כדי לשמור תזכורות מבוססות מיקום."
        }
      ]
    ]
  }
}
