# Copy to .env and paste your key. Expo inlines EXPO_PUBLIC_* at build time.
#
# This value ends up inside the JS bundle and therefore inside the APK — it is
# not a secret. It is fine for your own device; before the app reaches anyone
# else, move the Gemini call behind a server (see src/config/geminiConfig.js).
EXPO_PUBLIC_GEMINI_API_KEY=
