# Copy to .env and paste your keys. Expo inlines EXPO_PUBLIC_* at build time.
#
# None of these are secrets once the app is built: the values end up inside the
# JS bundle and therefore inside the APK, where anyone with the file can read
# them. That is fine for your own device. Before the app reaches anyone else,
# each call belongs behind a server you control.

# Firebase — anonymous auth and the cloud mirror. See src/config/firebaseConfig.js.
#
# A Firebase web config is public by design and ships in every client, so these
# are here for portability (point the app at a different project without
# editing code), not secrecy. Leave them blank to use the project baked into
# firebaseConfig.js as a fallback.
#
# What actually protects the data is the Firestore rule. Everything is written
# under users/{uid}/…, so lock it down before this holds anything real:
#
#   match /users/{uid}/{document=**} {
#     allow read, write: if request.auth != null && request.auth.uid == uid;
#   }
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Gemini — powers Noa. See src/config/geminiConfig.js.
EXPO_PUBLIC_GEMINI_API_KEY=

# Your Gemini quota ceilings, for Noa's checkQuota tool.
#
# Token *usage* is measured exactly from the API's own usageMetadata and needs
# no configuration. These are the limits to measure it against, and they are
# left blank on purpose: quotas differ per model and per tier and Google moves
# them, so a default baked in here would be a confident wrong number. With
# them blank Noa reports usage and says the ceiling is unknown; fill them in
# from your Google AI Studio quota page and she reports what is left.
EXPO_PUBLIC_GEMINI_RPD_LIMIT=
EXPO_PUBLIC_GEMINI_RPM_LIMIT=
EXPO_PUBLIC_GEMINI_TPM_LIMIT=

# Google Maps Platform — powers Noa's live transit, routing and Places lookups.
# See src/config/googleMaps.js.
#
# Enable these on the key in Cloud Console, or the calls come back
# REQUEST_DENIED with no other explanation:
#   • Directions API   (transit + bicycling routes)
#   • Places API       (findLocalBusiness)
#   • Geocoding API    (turning typed place names into coordinates)
#
# Billed per request against your card. Before you ship this, restrict the key
# to your Android package name + SHA-1 fingerprint and set a daily quota cap —
# an unrestricted Maps key in a published APK is somebody else's free API.
EXPO_PUBLIC_GOOGLE_SERVICES_KEY=

# OpenAI — powers Whisper voice input (Noa, and dictated POS orders).
# Billed per minute of audio, with no free tier.
EXPO_PUBLIC_OPENAI_API_KEY=
